 0003           ; PRELIMINARY VERSION
 0003           ; 
 0003           ; Shortcomings:
 0003           ; Only supports up to 2 (out of 8 possible) receive filter
 0003           ;   => This version can only be used with a maximum of 2 RPDOs
 0003           ; 
 0003           ; Only supports a transmit queue of length "1"
 0003           ; If queue occupied, waits until it is clear
 0003           ; **************************************************************************/
 0003           ; 
 0003           ; #include "Camera.h"
 0003           ; #include "mc9s12a128.h"
 0003           ; #include "mcohw.h"
 0003           ; #include "Interrupts.h"
 0003           ; #include "Subroutines.h"
 0003           ; 
 0003           ; extern char Gen_Flags;
 0003           ; extern unsigned int Timer1;
 0003           ; 
 0003           ; // Global timer/conter variable, incremented every millisecond
 0003           ; UNSIGNED16 gTimCnt = 0;
 0003           ; 
 0003           ; // global can filter count
 0003           ; UNSIGNED8 gCANFilter = 0;
 0003           ; 
